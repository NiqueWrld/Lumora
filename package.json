{
  "name": "react-ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -n app,server,desktop -c cyan,magenta,yellow \"npm:dev:app\" \"npm:dev:server\" \"npm:dev:desktop\"",
    "dev:app": "vite",
    "dev:server": "nodemon --watch Server/Drive --ext py --ignore Server/Drive/__pycache__ --exec \"Server/.venv/Scripts/python.exe -m Server.Drive.main\"",
    "dev:desktop": "electron .",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "4",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.3",
    "electron": "^43.1.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "nodemon": "^3.1.14",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "5"
  }
}
